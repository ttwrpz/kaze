<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>Theerawat Patthawee</Authors>
    <Product>Kaze for airCloud Go</Product>
    <Copyright>Copyright (c) 2026 Theerawat Patthawee. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ttwrpz/kaze</RepositoryUrl>
  </PropertyGroup>
</Project>
