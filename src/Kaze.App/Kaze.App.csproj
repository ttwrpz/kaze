<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kaze.App</RootNamespace>
    <AssemblyName>Kaze</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;th</SatelliteResourceLanguages>
  </PropertyGroup>
  <!--
    Release builds drop the parts of .NET and the Windows SDK projection that Kaze never calls.
    "partial" trims only framework assemblies, so Kaze and its libraries stay whole. Settings, history
    and the local API use reflection-based JSON, and the jump list uses built-in COM interop, so both
    stay on. The JSON trim warnings point at Kaze's own types, which partial mode keeps.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <NoWarn>$(NoWarn);IL2026;IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="Kaze.App.Strings.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.13" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.15" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kaze.Core\Kaze.Core.csproj" />
  </ItemGroup>
  <!--
    The Windows App SDK writes a different app manifest for single-file builds (DLL paths under the
    unpack folder) but only regenerates it when the project changes. Publishing the folder build and
    then the single-file build would reuse the wrong one, so drop it whenever the mode changes.
  -->
  <Target Name="RegenerateManifestOnModeChange" BeforeTargets="CreateWinRTRegistration">
    <PropertyGroup>
      <_KazeManifestMode>single-file=$(PublishSingleFile)</_KazeManifestMode>
      <_KazeManifestStamp>$(IntermediateOutputPath)manifest-mode.txt</_KazeManifestStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_KazeManifestStamp)" Condition="Exists('$(_KazeManifestStamp)')">
      <Output TaskParameter="Lines" PropertyName="_KazeLastManifestMode" />
    </ReadLinesFromFile>
    <Delete Files="$(ApplicationManifest)" Condition="'$(_KazeLastManifestMode)' != '$(_KazeManifestMode)'" />
    <WriteLinesToFile File="$(_KazeManifestStamp)" Lines="$(_KazeManifestMode)" Overwrite="true" />
  </Target>
  <!-- Kaze ships in English and Thai only, and doesn't need the Windows Runtime metadata at run time. -->
  <Target Name="TrimWindowsAppSDKPayload" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_KazeUnusedPayload Include="@(MicrosoftWindowsAppSDKFiles)" Condition="'%(Extension)' == '.winmd'" />
      <_KazeUnusedPayload Include="@(MicrosoftWindowsAppSDKFiles)" Condition="'%(Extension)' == '.mui' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(RecursiveDir)', '(?i)^(en-us|th-th)[\\/]'))" />
      <None Remove="@(_KazeUnusedPayload)" />
    </ItemGroup>
  </Target>
  <!--
    Unpackaged publish leaves out the compiled XAML (.xbf) and the app's resources.pri, and every page
    then fails to load. Adding them to the publish list also puts them inside a single-file build.
  -->
  <Target Name="AddXamlResourcesToPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="Build">
    <ItemGroup>
      <_KazeXamlResource Include="$(ProjectDir)$(OutDir)**\*.xbf" />
      <_KazeXamlResource Include="$(ProjectDir)$(OutDir)$(TargetName).pri" />
      <ResolvedFileToPublish Remove="@(_KazeXamlResource)" />
      <ResolvedFileToPublish Include="@(_KazeXamlResource)" RelativePath="%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(ProjectDir)$(OutDir)$(TargetName).pri" RelativePath="resources.pri" CopyToPublishDirectory="PreserveNewest" Condition="'$(PublishSingleFile)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
