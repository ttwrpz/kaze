<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaze.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Kaze.App.Helpers">
    <Grid>
        <StackPanel MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="24">
            <Image Width="64" Height="64" HorizontalAlignment="Left" Source="ms-appx:///Assets/AppIcon.png" />
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="{h:T Key=Login_SignInToAirCloudGo}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="{h:T Key=Login_UseTheSameEmailOr}" />
            <TextBox x:Name="LoginBox" Header="{h:T Key=Login_EmailOrPhoneNumber}" InputScope="EmailSmtpAddress" KeyDown="Field_KeyDown" />
            <PasswordBox x:Name="PasswordBox" Header="{h:T Key=Login_Password}" KeyDown="Field_KeyDown" />
            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="SignIn_Click" Content="{h:T Key=Login_SignIn}" />
                    <Button x:Name="CancelButton" MinWidth="96" Click="Cancel_Click" Content="{h:T Key=Login_Cancel}" Visibility="Collapsed" />
                </StackPanel>
                <ProgressRing x:Name="Busy" Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left" IsActive="False" />
            </Grid>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                       Text="{h:T Key=Login_KazeIsAnUnofficialApp}" />
        </StackPanel>
    </Grid>
</Page>
