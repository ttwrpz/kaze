<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="Kaze.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Kaze.App.Helpers"
    xmlns:winex="using:WinUIEx"
    Title="Kaze"
    MinWidth="360"
    MinHeight="480"
    Width="1000"
    Height="740">
    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Kaze"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button
                    x:Name="AccountButton"
                    Height="32"
                    Margin="0,0,4,0"
                    Padding="4,0"
                    AutomationProperties.Name="{h:T Key=Main_Accounts}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{h:T Key=Main_Accounts}">
                    <PersonPicture x:Name="AccountPicture" Width="24" Height="24" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Opening="AccountMenu_Opening" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1008"
            PaneDisplayMode="Auto"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{h:T Key=Main_Control}" Tag="Control">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{h:T Key=Main_SchedulesAndTimers}" Tag="Schedules">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{h:T Key=Main_Energy}" Tag="Energy">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{h:T Key=Main_AutomationsAndPresets}" Tag="Automations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Frame x:Name="LoginFrame" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</winex:WindowEx>
