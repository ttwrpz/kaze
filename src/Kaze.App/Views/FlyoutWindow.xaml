<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="Kaze.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Kaze.App.Helpers"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:Kaze.App.Controls"
    Title="Kaze"
    IsTitleBarVisible="False"
    IsMinimizable="False"
    IsMaximizable="False"
    IsResizable="False"
    IsAlwaysOnTop="True"
    IsShownInSwitchers="False">
    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Padding="16,16,16,12" VerticalScrollBarVisibility="Auto">
            <controls:ControlPanel />
        </ScrollViewer>
        <Grid
            Grid.Row="1"
            Height="48"
            Padding="16,0,8,0"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{h:T Key=Flyout_AirCloudGo}" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <Button AutomationProperties.Name="{h:T Key=Flyout_Refresh}" Click="Refresh_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{h:T Key=Flyout_Refresh}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button AutomationProperties.Name="{h:T Key=Flyout_OpenKaze}" Click="Open_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{h:T Key=Flyout_OpenKaze}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
