<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaze.App.Views.SchedulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Kaze.App.Helpers"
    xmlns:local="using:Kaze.App.Views"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16,16,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel x:Name="PageRoot" MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource CardSpacing}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{h:T Key=Schedules_SchedulesAndTimers}" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{h:T Key=Schedules_SchedulesRunOnThisPC}"
                Severity="Informational" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{h:T Key=Schedules_Timers}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <tk:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <ComboBox x:Name="TimerUnit" MinWidth="170" Header="{h:T Key=Schedules_Unit}" />
                        <ComboBox x:Name="TimerAction" MinWidth="120" Header="{h:T Key=Schedules_Action}" SelectedIndex="0">
                            <x:String>Turn off</x:String>
                            <x:String>Turn on</x:String>
                        </ComboBox>
                        <NumberBox
                            x:Name="TimerMinutes"
                            MinWidth="120"
                            Header="{h:T Key=Schedules_InMinutes}"
                            Maximum="1440"
                            Minimum="1"
                            SmallChange="15"
                            SpinButtonPlacementMode="Compact"
                            Value="60" />
                        <Button VerticalAlignment="Bottom" Click="AddTimer_Click" Content="{h:T Key=Schedules_StartTimer}" Style="{StaticResource AccentButtonStyle}" />
                    </tk:WrapPanel>
                    <ItemsControl x:Name="TimersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TimerRow">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE916;" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Text}" />
                                    <Button Grid.Column="2" Click="CancelTimer_Click" Content="{h:T Key=Schedules_Cancel}" Tag="{x:Bind Id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoTimers" Style="{StaticResource SecondaryTextStyle}" Text="{h:T Key=Schedules_NoTimersRunning}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,8">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{h:T Key=Schedules_WeeklySchedules}" />
                <Button HorizontalAlignment="Right" Click="AddRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="{h:T Key=Schedules_AddSchedule}" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsControl x:Name="RulesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource CardSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RuleRow">
                        <tk:SettingsCard Description="{x:Bind Detail}">
                            <tk:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Time}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Title}" />
                                </StackPanel>
                            </tk:SettingsCard.Header>
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE787;" /></tk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleSwitch MinWidth="0" IsOn="{x:Bind Enabled}" OffContent="" OnContent="" Tag="{x:Bind Id}" Toggled="RuleEnabled_Toggled" />
                                <Button AutomationProperties.Name="{h:T Key=Schedules_Edit}" Click="EditRule_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="{h:T Key=Schedules_Edit}">
                                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                </Button>
                                <Button AutomationProperties.Name="{h:T Key=Schedules_Delete}" Click="DeleteRule_Click" Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="{h:T Key=Schedules_Delete}">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Name="NoRules"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{h:T Key=Schedules_NoSchedulesYetForExample}" />
        </StackPanel>
    </ScrollViewer>
</Page>
